# 放进 wxapi.aibuzz.cn 的 HTTPS server 块。只公开 CDN 文件，不公开 AIStar 其它 API；
# 军师 BFF 从同机 127.0.0.1:8081 回源。
location /clip_preprod/cdn/ {
    proxy_pass http://127.0.0.1:8081;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 300s;
}

location /clip_preprod/files/ {
    proxy_pass http://127.0.0.1:8081;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 300s;
}
