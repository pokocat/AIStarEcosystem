# Install on the OLD host only in the approved cutover window, after its API is stopped.
# Keeps existing Next rewrites to localhost:8080 working while frontends migrate separately.
# Never proxy to api.aibuzz.cn by DNS here: stale DNS could point back to this host.
server {
    listen 127.0.0.1:8080;
    server_name localhost;
    location = /internal/deployment { return 404; }
    location ^~ /internal/deployment/ { return 404; }
    location / {
        resolver 100.100.2.136 100.100.2.138 valid=30s ipv6=off;
        set $aistar_alb_origin alb-8lqfxfyvfyitbs3s6r.cn-hangzhou.alb.aliyuncsslb.com;
        proxy_pass https://$aistar_alb_origin$request_uri;
        proxy_ssl_server_name on;
        proxy_ssl_name api.aibuzz.cn;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate /etc/pki/tls/certs/ca-bundle.crt;
        proxy_set_header Host api.aibuzz.cn;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 600s;
    }
}
