# AI Star Eco — music.aibuzz.cn HTTPS entry for apps/web-music (port 3010).
# Install to: /etc/nginx/conf.d/music.aibuzz.cn.ssl.conf
#
# 该子域的 80 vhost 在生产上位于 aistareco.conf（不是本文件），本文件只补 443。
# 每个子域必须同时有 80 和 443 vhost —— 缺 443 会被浏览器 HTTPS-First / HSTS
# 打到 nginx 的「443 默认 server」（按 conf.d 字典序 = admin），302 到 /admin。
# 详见 infra/README.md §5「nginx vhost：每子域必须同时有 80 和 443」。
#
# 证书：全站共用 *.aibuzz.cn 泛域名证书（SAN 含 *.aibuzz.cn + aibuzz.cn），
#   /etc/nginx/certs/aibuzz.cn/fullchain.pem
#   /etc/nginx/certs/aibuzz.cn/privkey.key
#
# 以下 server 块与线上 /etc/nginx/conf.d/music.aibuzz.cn.ssl.conf 逐字节一致。

# AI Star Eco — music.aibuzz.cn HTTPS entry for apps/web-music (port 3010).
# Added 2026-08-29: previously no 443 vhost existed for music, so HTTPS
# requests fell through to the default SSL server (admin) and were
# 302-redirected to /admin. Reuses the shared *.aibuzz.cn wildcard cert.

server {
    listen 443 ssl;
    http2 on;
    server_name music.aibuzz.cn;

    ssl_certificate /etc/nginx/certs/aibuzz.cn/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/aibuzz.cn/privkey.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 200m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    location /api/ {
        proxy_pass http://127.0.0.1:8080/api/;
        proxy_connect_timeout 30s;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }

    location /static/ { proxy_pass http://127.0.0.1:8080/static/; }
    location /cdn/ { proxy_pass http://127.0.0.1:8080/cdn/; }
    location / { proxy_pass http://127.0.0.1:3010; }
}
