# AI Star Eco — star.aibuzz.cn HTTP(:80) entry for apps/web-star。
#
# 2026-09-06：此前 80 直接明文反代 3014，而 443（star.aibuzz.cn.ssl.conf）又发 HSTS，
# 行为不一致。现统一 308 跳 HTTPS；308 保留方法与 body，POST 不会被降级成 GET。
# 真正的服务端配置在 star.aibuzz.cn.ssl.conf（443，含 /api/ /static/ /cdn/）。
#
# 回滚：sudo cp star.aibuzz.cn.conf.before-http-redirect-20260906 star.aibuzz.cn.conf
#       && sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name star.aibuzz.cn;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location / { return 308 https://$host$request_uri; }
}
