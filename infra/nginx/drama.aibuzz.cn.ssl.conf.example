# AI Star Eco — drama.aibuzz.cn HTTPS entry for apps/web-drama (port 3011).
# Install to: /etc/nginx/conf.d/drama.aibuzz.cn.ssl.conf
#
# 该子域的 80 vhost 在生产上位于 aistareco.conf（不是本文件），本文件只补 443。
# 每个子域必须同时有 80 和 443 vhost —— 缺 443 会被浏览器 HTTPS-First / HSTS
# 打到 nginx 的「443 默认 server」（按 conf.d 字典序 = admin），302 到 /admin。
# 详见 infra/README.md §5「nginx vhost：每子域必须同时有 80 和 443」。
#
# 证书：全站共用 *.aibuzz.cn 泛域名证书（SAN 含 *.aibuzz.cn + aibuzz.cn），
#   /etc/nginx/certs/aibuzz.cn/fullchain.pem
#   /etc/nginx/certs/aibuzz.cn/privkey.key
#
# ⚠️ 与线上的唯一差异（有意为之，2026-08-29 核对）：
#    线上 drama.aibuzz.cn.ssl.conf 的 ssl_certificate* 仍指向历史遗留路径
#      /etc/nginx/ssl/drama.aibuzz.cn/{fullchain.pem,privkey.key}
#    该目录里放的是**同一张泛域名证书的副本**（md5 与 /etc/nginx/certs/aibuzz.cn/
#    完全相同），不是独立签发的 drama 单域证书。本 example 统一收敛到共享泛域名
#    路径，避免续期时漏掉某个副本。`diff` 线上文件时会看到这两行不同，属预期。
#    /etc/nginx/ssl/{admin,aistar,bossclub,drama}.aibuzz.cn/ 均为同一副本情形。
#
# 其余部分与线上 /etc/nginx/conf.d/drama.aibuzz.cn.ssl.conf 逐字节一致。

server {
    listen 443 ssl;
    http2 on;
    server_name drama.aibuzz.cn;

    ssl_certificate /etc/nginx/certs/aibuzz.cn/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/aibuzz.cn/privkey.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 200m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    location /api/ {
        proxy_pass http://127.0.0.1:8080/api/;
        proxy_connect_timeout 30s;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }

    location /static/ { proxy_pass http://127.0.0.1:8080/static/; }
    location /cdn/ { proxy_pass http://127.0.0.1:8080/cdn/; }
    location / { proxy_pass http://127.0.0.1:3011; }
}
