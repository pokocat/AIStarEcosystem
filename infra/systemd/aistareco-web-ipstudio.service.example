# /etc/systemd/system/aistareco-web-ipstudio.service
# apps/web-ipstudio — Next 16 standalone（根路径，默认端口 3015）

[Unit]
Description=AI Star Eco Web IP Studio
After=network-online.target aistareco-server.service
Wants=network-online.target

[Service]
Type=simple
User=ecs-user
WorkingDirectory=/opt/ai-star-eco/web-ipstudio/apps/web-ipstudio
EnvironmentFile=/etc/aistareco/web-ipstudio.env
ExecStart=/usr/bin/node /opt/ai-star-eco/web-ipstudio/apps/web-ipstudio/server.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
