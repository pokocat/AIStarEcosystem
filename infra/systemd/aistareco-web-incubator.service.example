# /etc/systemd/system/aistareco-web-incubator.service
# apps/web-incubator — Next 16 standalone（纯前端演示，根路径，默认端口 3020）

[Unit]
Description=AI Star Eco Web Incubator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ecs-user
WorkingDirectory=/opt/ai-star-eco/web-incubator/apps/web-incubator
EnvironmentFile=/etc/aistareco/web-incubator.env
ExecStart=/usr/bin/node /opt/ai-star-eco/web-incubator/apps/web-incubator/server.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
