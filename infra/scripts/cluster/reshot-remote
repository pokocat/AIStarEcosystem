#!/bin/bash
# Adapter for the argument list issued by StudioDepthVideoService.
set -euo pipefail

runtime=/opt/studio-depth
ssh=(/usr/bin/ssh -F /dev/null -T -i /run/aistar-depth/id_ed25519
  -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes
  -o UserKnownHostsFile="$runtime/known_hosts" -o GlobalKnownHostsFile=/dev/null
  -o ConnectTimeout=8 -o ServerAliveInterval=15 -o ServerAliveCountMax=3
  reshot@10.20.1.215)

if [[ $# == 1 && $1 == --version ]]; then
  exec "${ssh[@]}" version
fi

input=${1:?missing input}
shift
[[ $input =~ ^/tmp/studio-depth-[0-9]+/reference-24fps\.mp4$ && -r $input ]]
directory=${input%/*}
declare -A options=()
while (( $# )); do
  (( $# >= 2 )) || exit 2
  case $1 in
    -o|--control|--checkpoint-dir|--checkpoint|--keypoints|--model|--target|--max-res|--input-size|--quality) ;;
    *) exit 2 ;;
  esac
  [[ -z ${options[$1]+present} ]] || exit 2
  options[$1]=$2
  shift 2
done
[[ ${options[--target]:-} == h3 && ${options[--max-res]:-} =~ ^[0-9]{3,4}$ ]]
case ${options[--control]:-} in
  pose)
    [[ ${#options[@]} == 6 && ${options[-o]:-} == "$directory/pose.mp4" &&
      ${options[--checkpoint-dir]:-} == "$runtime/weights/dwpose" &&
      ${options[--keypoints]:-} == "$directory/pose.json" ]] || exit 2
    run=("run-pose" "${options[--max-res]}")
    ;;
  depth)
    [[ ${#options[@]} == 7 && ${options[-o]:-} == "$directory/depth.mp4" &&
      ${options[--model]:-} == small &&
      ${options[--checkpoint]:-} == "$runtime/weights/video_depth_anything_vits.pth" ]] || exit 2
    size=${options[--input-size]:-}
    if [[ -z $size && ${options[--quality]:-} == fast ]]; then size=252; fi
    [[ $size =~ ^[0-9]{3}$ ]] || exit 2
    run=("run-depth" "${options[--max-res]}" "$size")
    ;;
  *) exit 2 ;;
esac

read -r job < /proc/sys/kernel/random/uuid
job=${job//-/}
trap '"${ssh[@]}" cleanup "$job" >/dev/null 2>&1 || true' EXIT
trap 'exit 143' TERM INT
"${ssh[@]}" upload "$job" < "$input"
"${ssh[@]}" "${run[0]}" "$job" "${run[@]:1}" </dev/null
"${ssh[@]}" download "$job" output > "${options[-o]}"
if [[ ${options[--control]} == pose ]]; then
  "${ssh[@]}" download "$job" keypoints > "${options[--keypoints]}"
fi
