# ─────────────────────────────────────────────────────────────────────────────
# apps/web-celebrity — Next 16 standalone（根路径，无 basePath）
# 落位：/opt/ai-star-eco/repo/apps/web-celebrity/.env
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3012
HOSTNAME=0.0.0.0          # 当前 :3012 直接暴露公网；上 nginx + 子域后改 127.0.0.1

NEXT_PUBLIC_USE_MOCK=0
# 这里要写公网 base，因为浏览器直接打的是 :3012/api/...
# 生产形态：
NEXT_PUBLIC_SERVER_API_BASE=https://api.aibuzz.cn

# v0.8+ mixcut 真后端独立开关（USE_MOCK=1 时仍走真后端）
NEXT_PUBLIC_MIXCUT_USE_REAL=1

# ── 统一账号中心登录（id.aibuzz.cn，docs/unified-identity-plan.md §12.5）────────
# authMode=id 时 AuthProvider 不再走本仓登录页，而是跳账号中心做授权码 + PKCE，
# 回跳 /auth/callback 换令牌。判定顺序：显式 AUTH_MODE 优先，否则「配了 ISSUER 即 id」；
# USE_MOCK=1 一律回落 legacy。回退方式：改回 legacy 并**重新构建**（见下）。
#
# ⚠️ 这三个是 NEXT_PUBLIC_*，Next 在**构建期**把它们内联成字面量。只改这个运行期 env 文件
#    不会生效 —— 必须让打包时也带上（infra/scripts/build-release.sh 的
#    NEXT_PUBLIC_AUTH_MODE / NEXT_PUBLIC_ID_ISSUER 环境变量，默认 legacy）。
#
# ⚠️ 切到 id 之前必须先满足三个前置，否则用户直接登不进来：
#    ① https://id.aibuzz.cn/.well-known/openid-configuration 返回 200（443 vhost 已装）
#    ② 账号中心已注册 client_id=web-celebrity，redirect_uri 与本站 origin 逐字符一致
#    ③ 账号中心的 ID_CORS_ALLOWED_ORIGINS 里含本站 origin（浏览器直连 POST /oauth2/token
#       是跨源请求；没列上就会被浏览器拦下，而服务端日志里什么都看不到）
NEXT_PUBLIC_AUTH_MODE=id
NEXT_PUBLIC_ID_ISSUER=https://id.aibuzz.cn
NEXT_PUBLIC_ID_CLIENT_ID=web-celebrity
