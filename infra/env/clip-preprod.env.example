# AIStar clip 专用预发实例（仅供军师 BFF 回源）。真实值落 ECS
# /etc/aistareco/clip-preprod.env，权限 0600；两个 token 均禁止入 git。
SERVER_PORT=8081
SERVER_ADDRESS=127.0.0.1
SPRING_PROFILES_ACTIVE=clip-preprod
AEP_DEV_AUTH_ENABLED=false
AEP_SEED_DEV_DATA_ENABLED=false

# 军师 BFF ↔ clip 服务的独立高熵共享密钥（不要复用石榴 token）。
AEP_CLIP_SERVICE_TOKEN=<FILL_RANDOM_SERVICE_TOKEN>
AEP_CLIP_ALLOW_MOCK=false

# 石榴文档站是 api.16ai.vip；真实 API BaseURL 是下方 api.16ai.chat。
AEP_CLIP_SHILIU_BASE_URL=https://api.16ai.chat/api/v1/
AEP_CLIP_SHILIU_TOKEN=<FILL_SHILIU_BEARER_TOKEN>

# 预发验收价；军师 BFF 仍是唯一积分账本，AIStar 只返回权威报价。
AEP_CLIP_PRICE_AVATAR_SECOND=1
AEP_CLIP_PRICE_TTS_PER_KCHAR=5
AEP_CLIP_PRICE_ASSEMBLE=0
AEP_CLIP_SEED_OFFICIAL_TEMPLATES=true

# 预发单机持久化：H2 文件库 + 本机 CDN，经 nginx 仅暴露 /clip_preprod/cdn/。
AEP_CDN_DRIVER=local
AEP_CDN_LOCAL_ROOT=/opt/aistareco-clip-preprod/cdn
AEP_CDN_PUBLIC_BASE_URL=https://wxapi.aibuzz.cn/clip_preprod/cdn
AEP_STORAGE_LOCAL_DIR=/opt/aistareco-clip-preprod/file-storage
AEP_STORAGE_PUBLIC_URL_BASE=https://wxapi.aibuzz.cn/clip_preprod/files
AEP_STORAGE_KEEP_LOCAL=true

# 即使实例不对公网开放其它 API，也使用独立预发密钥，不沿用 dev 默认值。
AEP_JWT_SECRET=<FILL_32_CHAR_HIGH_ENTROPY_SECRET>
AEP_INTERNAL_SECRET=<FILL_RANDOM_INTERNAL_SECRET>
AEP_SECRET_KEY=<FILL_RANDOM_ENCRYPTION_SECRET>
