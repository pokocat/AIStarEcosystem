# apps/web-aiavatar/studio-admin — independent Studio operations dashboard.
# Install as /etc/aistareco/studio-admin.env (mode 600).

NODE_ENV=production
PORT=3004
HOSTNAME=127.0.0.1

# Browser requests stay same-origin. Next proxies /api/* to the shared API server.
# This value is consumed by next.config.mjs when the release is built.
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_SERVER_API_BASE=http://127.0.0.1:8080
NEXT_PUBLIC_STUDIO_ADMIN_BASE_PATH=/admin
