# ─────────────────────────────────────────────────────────────────────────────
# apps/web-ipstudio — AI IP 工作台 · Next 16 standalone（根路径，无 basePath）
# 落位：/etc/aistareco/web-ipstudio.env，由 systemd EnvironmentFile 注入。
#
# 子产品开通：共用 aiavatar 开通（不新增产品码），接口全挂 /api/v1/ip-studio/**，
# 由 EnrollmentGuard 的 /api/v1/** 前缀兜底映射到 aiavatar。
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3015
HOSTNAME=127.0.0.1

NEXT_PUBLIC_USE_MOCK=0
NEXT_PUBLIC_ENABLE_DEV_LOGIN=0
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_SERVER_API_BASE=http://127.0.0.1:8080

# 发布成功后「去 AiAvatar 查看这个资产」的落点。
NEXT_PUBLIC_AIAVATAR_URL=https://aiavatar.aibuzz.cn

# ⚠️ 上面的 NEXT_PUBLIC_* 是**构建期内联**的字面量。只改这个运行期 env 文件不会生效 ——
#    真正生效的取值来自 infra/scripts/build-release.sh 打包时的同名环境变量。
#    这里保留一份是为了对照与排障（看运行的这台机器「本该」是什么配置）。

# ── 统一账号中心登录（id.aibuzz.cn，docs/unified-identity-plan.md §12.5）────────
# authMode=id 时 AuthProvider 不再走本仓登录页，而是跳账号中心做授权码 + PKCE，
# 回跳 /auth/callback 换令牌。判定顺序：显式 AUTH_MODE 优先，否则「配了 ISSUER 即 id」；
# USE_MOCK=1 一律回落 legacy。回退方式：改回 legacy 并**重新构建**（见上）。
#
# ⚠️ 三个前置在 2026-09-06 已全部满足（本站已切 id 模式）：
#    ① https://id.aibuzz.cn/.well-known/openid-configuration 返回 200（443 vhost 已装）
#    ② 账号中心已注册 client_id=web-ipstudio，redirect_uri 与本站 origin 逐字符一致
#    ③ 账号中心的 ID_CORS_ALLOWED_ORIGINS 里含 https://ipstudio.aibuzz.cn（浏览器直连
#       POST /oauth2/token 是跨源请求；没列上就会被浏览器拦下，服务端日志里什么都看不到）
NEXT_PUBLIC_AUTH_MODE=id
NEXT_PUBLIC_ID_ISSUER=https://id.aibuzz.cn
NEXT_PUBLIC_ID_CLIENT_ID=web-ipstudio
