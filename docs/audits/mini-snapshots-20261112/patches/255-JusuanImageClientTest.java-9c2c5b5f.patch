+    @Test void slowImageBodyHasItsOwnDownloadDeadlineAndReportsAReceivedResult() throws Exception {
+        var ep=endpoint("image-model");
+        ep.setImageRequestSpecJson("""
+                {"promptMaxChars":1000,"minReferenceImages":0,"maxReferenceImages":0,"referenceField":"none",
+                 "outputs":[{"canvasSize":"1024x1024","aspectRatio":"1:1","providerFields":{}}],
+                 "wire":{"resultMode":"sync-url","outputPointer":"/url","requestTimeoutMillis":250}}
+                """);
+        when(models.resolveEndpoint(AiModelPurpose.DAP_IMAGE,"ep","studio"))
+                .thenReturn(Optional.of(new AiModelInvocationService.ResolvedEndpoint(ep,null,true)));
+        when(upstream.sendJson(any(),any())).thenReturn(json("{\"url\":\"https://8.8.8.8/result.png\"}"));
+        var closed=new java.util.concurrent.CountDownLatch(1);
+        var response=mock(HttpResponse.class);
+        when(response.statusCode()).thenReturn(200);
+        when(response.body()).thenReturn(new java.io.InputStream() {
+            @Override public int read() throws java.io.IOException {
+                try {if(!closed.await(3,java.util.concurrent.TimeUnit.SECONDS))throw new java.io.IOException("body not canceled");}
+                catch(InterruptedException e){Thread.currentThread().interrupt();throw new java.io.IOException(e);}
+                return -1;
+            }
+            @Override public void close(){closed.countDown();}
+        });
+        when(http.send(any(),any())).thenReturn(response);
+        var result=assertThrows(JusuanImageClient.ProviderRejected.class,
+                ()->client.generate("ep","portrait","1024x1024",List.of(),"slow-body","owner",stage->{}));
+        assertTrue(result.getMessage().contains("已返回图片，但下载超时"),result.getMessage());
+        verify(upstream,times(1)).sendJson(any(),any());
+    }
