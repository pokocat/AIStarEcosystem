+    @Test void syncUrlIsCheckpointedBeforeDownloadAndRecoveredWithoutAnotherPost() throws Exception {
+        var ep=endpoint("image-model");
+        ep.setImageRequestSpecJson("""
+                {"promptMaxChars":1000,"minReferenceImages":0,"maxReferenceImages":0,"referenceField":"none",
+                 "outputs":[{"canvasSize":"1024x1024","aspectRatio":"1:1","providerFields":{}}],
+                 "wire":{"resultMode":"sync-base64","outputPointer":"/data/0/b64_json"}}
+                """);
+        when(models.resolveEndpoint(AiModelPurpose.DAP_IMAGE,"ep","studio"))
+                .thenReturn(Optional.of(new AiModelInvocationService.ResolvedEndpoint(ep,null,true)));
+        when(models.storedEndpoint("ep")).thenReturn(Optional.of(ep));
+        String originalUrl="http://8.8.8.8:8080/original.png?signature=opaque";
+        when(upstream.sendJson(any(),any())).thenReturn(json("{\"data\":[{\"url\":\""+originalUrl+"\"}]}"));
+        var checkpoint=new java.util.concurrent.atomic.AtomicReference<com.fasterxml.jackson.databind.node.ObjectNode>();
+        byte[] bytes=Base64.getDecoder().decode(PNG_1X1);
+        var downloaded=mock(HttpResponse.class);
+        when(downloaded.statusCode()).thenReturn(200);
+        when(downloaded.body()).thenReturn(new ByteArrayInputStream(bytes));
+        var downloads=new java.util.concurrent.atomic.AtomicInteger();
+        when(http.send(any(),any())).thenAnswer(inv->{
+            HttpRequest request=inv.getArgument(0);
+            assertEquals(originalUrl,checkpoint.get().path("resultUrl").asText());
+            assertEquals(originalUrl,request.uri().toString());
+            assertTrue(request.headers().firstValue("Authorization").isEmpty());
+            if(downloads.getAndIncrement()==0)throw new InterruptedException("process stopped");
+            return downloaded;
+        });
+        try {
+            var error=assertThrows(JusuanImageClient.Pending.class,()->client.generate("ep","portrait","1024x1024",List.of(),
+                    "receipt-key","owner",stage->{},null,null,null,checkpoint::set));
+            assertEquals("STUDIO_IMAGE_RECOVERING",error.code());
+        } finally {
+            Thread.interrupted();
+        }
+        assertArrayEquals(bytes,client.generate("ep","portrait","1024x1024",List.of(),"receipt-key","owner",
+                stage->{},null,null,checkpoint.get(),checkpoint::set));
+        verify(upstream,times(1)).sendJson(any(),any());
+        assertEquals(2,downloads.get());
+    }
