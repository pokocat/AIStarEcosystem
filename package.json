{
  "name": "ai-star-eco-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "AI Star Eco monorepo — 五个子产品（音乐人/短剧/明星带货/AiAvatar数字资产/明星商务）共享后端与 packages/*。全部 Next 16 + React 19 + pnpm workspace；遗留 apps/web（legacy Next 14）已于 Phase 5（2026-08-03）删除。",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.9",
    "pnpm": ">=10"
  },
  "scripts": {
    "typecheck:web-music": "pnpm --filter @ai-star-eco/web-music run typecheck",
    "typecheck:web-drama": "pnpm --filter @ai-star-eco/web-drama run typecheck",
    "typecheck:web-celebrity": "pnpm --filter @ai-star-eco/web-celebrity run typecheck",
    "typecheck:web-aiavatar": "pnpm --filter @ai-star-eco/web-aiavatar run typecheck",
    "typecheck:web-star": "pnpm --filter @ai-star-eco/web-star run typecheck",
    "typecheck:web-ipstudio": "pnpm --filter @ai-star-eco/web-ipstudio run typecheck",
    "typecheck:all": "pnpm -r --parallel run typecheck",
    "test:all": "pnpm -r --parallel run test",
    "dev:music": "pnpm --filter @ai-star-eco/web-music run dev",
    "dev:drama": "pnpm --filter @ai-star-eco/web-drama run dev",
    "dev:celebrity": "pnpm --filter @ai-star-eco/web-celebrity run dev",
    "dev:aiavatar": "pnpm --filter @ai-star-eco/web-aiavatar run dev",
    "dev:star": "pnpm --filter @ai-star-eco/web-star run dev",
    "dev:ipstudio": "pnpm --filter @ai-star-eco/web-ipstudio run dev",
    "dev:admin": "pnpm --filter @ai-star-eco/admin-new run dev",
    "typecheck:admin": "pnpm --filter @ai-star-eco/admin-new run typecheck",
    "check:api-contract": "node scripts/check-api-contract.mjs",
    "check:wire-mirror": "node scripts/check-wire-mirror.mjs",
    "drama:recipe:prep": "node scripts/drama-recipe/prep.mjs",
    "drama:recipe:build": "node scripts/drama-recipe/build-seed.mjs",
    "drama:recipe:check": "node scripts/drama-recipe/build-seed.mjs --check"
  },
  "dependencies": {
    "miniprogram-ci": "^2.1.31"
  }
}
