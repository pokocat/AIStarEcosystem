# ========================================
# 支付宝支付 - 环境变量配置模板
# 文件名: .env.alipay 或 .env.alipay.local
# 注意: 此文件包含敏感信息，请勿提交到 Git！
# ========================================

# 应用信息
ALIPAY_APP_ID=2021006169613183
ALIPAY_APP_NAME=AIStarEcoSystem

# === 关键配置 ===
# 请从支付宝开发者平台获取以下信息：
# 路径: https://open.alipay.com/develop/pm/sub/setting
#      -> 接口加签方式 -> 设置 -> 生成密钥工具

# 应用私钥（RSA2）- 由密钥工具生成，妥善保管！
# 格式：-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
ALIPAY_APP_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----
MIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQDr...这里放你的应用私钥...
-----END PRIVATE KEY-----

# 支付宝公钥 - 从支付宝开发者平台获取
# 格式：-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
ALIPAY_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----
MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...这里放支付宝公钥...
-----END PUBLIC KEY-----

# === 网关配置 ===
# 生产环境
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do

# 沙箱环境（测试时使用）
ALIPAY_SANDBOX_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_SANDBOX_ENABLED=false

# === 回调配置 ===
# 异步回调地址（支付宝会调用此地址通知支付结果）
ALIPAY_NOTIFY_URL=https://api.aibuzz.cn/api/alipay/notify

# 同步返回地址（用户完成支付后返回到商户网站）
ALIPAY_RETURN_URL=https://aibuzz.cn/payment/return

# === 签名配置 ===
ALIPAY_SIGN_TYPE=RSA2
ALIPAY_CHARSET=UTF-8
ALIPAY_FORMAT=JSON

# === 其他配置 ===
# 支付超时时间（如：30m、1h）
ALIPAY_TIMEOUT_EXPRESS=30m

# 是否验证签名（生产环境务必设为 true）
ALIPAY_VERIFY_SIGN=true

# 日志级别
ALIPAY_LOG_LEVEL=INFO

# ========================================
# 使用说明
# ========================================
# 1. 复制此文件为 .env.alipay（去掉 .example）
# 2. 填入你的应用私钥和支付宝公钥
# 3. 将 .env.alipay 加入 .gitignore（保护密钥安全）
# 4. 在项目启动时加载此文件
#
# Spring Boot 加载方式：
#   - 使用 spring.config.import 或 @PropertySource 加载
#   - 或使用 dotenv 库自动加载
#
# 获取密钥的步骤：
# 1. 访问支付宝开发者平台：https://open.alipay.com
# 2. 进入你的应用详情页
# 3. 点击"开发设置" -> "接口加签方式" -> "设置"
# 4. 选择"密钥"方式，RSA2 算法
# 5. 下载密钥工具，生成公钥和私钥
# 6. 将生成的密钥粘贴到此文件
# ========================================
