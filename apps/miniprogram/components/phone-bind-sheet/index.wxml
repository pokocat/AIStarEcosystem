<view wx:if="{{visible}}" class="mask" bindtap="close">
  <view class="sheet safe-bottom" catchtap="noop">
    <view class="grabber"></view>

    <view class="head">
      <view class="eyebrow">ACCOUNT · PHONE</view>
      <view class="title">绑定手机号</view>
    </view>
    <view class="reason">{{reason}}</view>

    <!-- 微信一键取号 -->
    <block wx:if="{{!blocked && mode === 'wechat'}}">
      <button
        class="cta primary"
        open-type="getPhoneNumber"
        bindgetphonenumber="onGetPhoneNumber"
        disabled="{{busy}}"
      >{{busy ? '绑定中…' : '微信一键绑定'}}</button>
      <view class="alt" bindtap="switchToSms">用短信验证码绑定</view>
    </block>

    <!-- 短信兜底 -->
    <block wx:elif="{{!blocked}}">
      <view class="field">
        <text class="prefix mono">+86</text>
        <view class="divider"></view>
        <input
          class="input"
          type="number"
          placeholder="请输入手机号"
          placeholder-class="ph"
          value="{{phone}}"
          bindinput="onPhoneInput"
          maxlength="11"
        />
      </view>
      <view class="field">
        <text class="label">验证码</text>
        <input
          class="input mono"
          type="number"
          placeholder="6 位"
          placeholder-class="ph"
          value="{{code}}"
          bindinput="onCodeInput"
          maxlength="6"
        />
        <view class="sms-btn {{cooldown > 0 || busy ? 'sms-btn-off' : ''}}" bindtap="sendCode">
          {{cooldown > 0 ? cooldown + 's 重发' : '获取验证码'}}
        </view>
      </view>
      <button
        class="cta primary {{canSubmitSms && !busy ? '' : 'cta-off'}}"
        bindtap="submitSms"
        disabled="{{!canSubmitSms || busy}}"
      >{{busy ? '绑定中…' : '确认绑定'}}</button>
      <view class="alt" bindtap="switchToWechat">返回微信一键绑定</view>
    </block>

    <view wx:if="{{error}}" class="error">{{error}}</view>

    <!-- 绑定已生效、但本地登录态没换上：不能再绑一次，也不能当成功放行 -->
    <block wx:if="{{blocked}}">
      <view class="tip">手机号已经绑定成功，只是这台设备的登录状态没能同步。完全退出小程序再打开即可继续。</view>
      <view class="cancel" bindtap="close">知道了</view>
    </block>
    <block wx:else>
      <view class="tip">手机号仅用于账号识别与安全验证，不会对外展示。</view>
      <view class="cancel" bindtap="close">以后再说</view>
    </block>
  </view>
</view>
