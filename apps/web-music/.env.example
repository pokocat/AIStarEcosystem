# Mock 模式开关（1=纯前端 mock，0=调真实后端）
NEXT_PUBLIC_USE_MOCK=1

# Spring Boot 后端地址（通过 next.config.mjs rewrites 代理）
NEXT_PUBLIC_SERVER_API_BASE=http://localhost:8080

# dev 登录入口：默认 next dev 显示、生产构建隐藏；联调环境如需打开设 1，开发也可设 0 强制关闭
# NEXT_PUBLIC_ENABLE_DEV_LOGIN=0

# AiAvatar 应用入口（「引入数字人」跳转用；本地联调改 http://localhost:3013）
NEXT_PUBLIC_AIAVATAR_URL=https://aistar.aibuzz.cn

# ── 登录模式（统一账号中心，docs/unified-identity-plan.md §12.5）──────────────
# id     = 登录跳 id.aibuzz.cn（OIDC 授权码 + PKCE），本站不再发验证码 / 收激活码注册
# legacy = 本仓 server 自己发验证码 / 签令牌（历史行为）
# 缺省：配了 NEXT_PUBLIC_ID_ISSUER 即 id，否则 legacy；NEXT_PUBLIC_USE_MOCK=1 一律 legacy。
# NEXT_PUBLIC_AUTH_MODE=legacy
# 账号中心地址（本地 http://localhost:8090 / 生产 https://id.aibuzz.cn）
# NEXT_PUBLIC_ID_ISSUER=http://localhost:8090
# 本 app 在账号中心注册的 client_id（dev 统一 web-dev；生产用 web-music）
# NEXT_PUBLIC_ID_CLIENT_ID=web-dev
